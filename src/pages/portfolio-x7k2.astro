---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import { careerHistory } from "../data/career";
import { skillCategories, industries } from "../data/skills";
---

<Layout title="Takashi Matsumoto | IT Consultant">
  <header
    class="fixed top-0 left-0 right-0 z-50 bg-[#fafafa]/80 backdrop-blur-sm border-b border-black/5"
  >
    <nav class="max-w-3xl mx-auto px-6 h-14 flex items-center gap-6">
      <span class="text-sm font-medium tracking-wide text-black/80">T. Matsumoto</span>
      <div class="flex items-center gap-4 ml-auto text-xs tracking-wider text-black/40">
        <a href="#about" class="hover:text-accent transition-colors">About</a>
        <a href="#career" class="hover:text-accent transition-colors">Career</a>
        <a href="#skills" class="hover:text-accent transition-colors">Skills</a>
        <a href="#contact" class="hover:text-accent transition-colors">Contact</a>
        <ThemeSwitcher />
      </div>
    </nav>
  </header>

  <div class="h-14"></div>

  <main>
    <!-- Hero -->
    <section class="pt-24 pb-20 px-6">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs tracking-[0.2em] text-black/30 uppercase mb-8">IT Consultant</p>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-black/90 leading-tight mb-6">
          Matsumoto<br />Takashi
        </h1>
        <p class="text-base text-black/50 leading-relaxed max-w-lg mb-10">
          システムエンジニアからITコンサルタントへ。<br />
          技術力とビジネス視点を融合し、課題解決に取り組んでいます。
        </p>
        <div class="flex gap-3">
          <a
            href="#career"
            class="text-xs tracking-wider px-6 py-2.5 bg-accent text-white rounded hover:opacity-80 transition-opacity"
          >
            Career
          </a>
          <a
            href="#contact"
            class="text-xs tracking-wider px-6 py-2.5 border border-accent/30 text-accent rounded hover:bg-accent/5 transition-colors"
          >
            Contact
          </a>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="py-20 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-xs tracking-[0.2em] text-black/30 uppercase mb-8">About</h2>
        <div class="space-y-4 text-sm text-black/60 leading-[1.9]">
          <p>
            大学・大学院にて情報アーキテクチャを専攻。日系大手SIerでのシステムエンジニアとしてキャリアをスタートし、金融機関向け基幹システムの開発で設計からリリースまでの全工程を経験しました。
          </p>
          <p>
            その後、ITコンサルティング企業を経て、直近では外資系大手総合コンサルティングファームにてIT・DX領域のコンサルティングに従事。プロジェクトマネジメント、データ分析、AI活用など幅広い領域でクライアントの課題解決に取り組んでいます。
          </p>
        </div>
        <div class="mt-12 grid sm:grid-cols-3 gap-6">
          <div>
            <p class="text-xs text-black/30 tracking-wider mb-1">Education</p>
            <p class="text-sm text-black/70">大学院修了 — 情報アーキテクチャ専攻</p>
          </div>
          <div>
            <p class="text-xs text-black/30 tracking-wider mb-1">Experience</p>
            <p class="text-sm text-black/70">10年以上のIT業界経験</p>
          </div>
          <div>
            <p class="text-xs text-black/30 tracking-wider mb-1">Strengths</p>
            <p class="text-sm text-black/70">技術 × ビジネス × プロジェクト推進</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Career (detailed) -->
    <section id="career" class="py-20 px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-xs tracking-[0.2em] text-black/30 uppercase mb-12">Career</h2>
        <div class="space-y-16">
          {
            careerHistory.map((entry) => (
              <div class="relative pl-6 border-l border-black/10">
                <div class="absolute left-0 top-[5px] -translate-x-1/2 w-2 h-2 rounded-full bg-accent" />
                <p class="text-xs font-mono text-accent/70 mb-1">{entry.period}</p>
                <h3 class="text-base font-semibold text-black/80 mb-0.5">{entry.company}</h3>
                <p class="text-xs text-black/40 mb-5">{entry.role}</p>
                <div class="space-y-4">
                  {entry.projects.map((project) => (
                    <div class="bg-white rounded-lg p-5 border border-black/5">
                      <h4 class="text-sm font-medium text-black/70 mb-1.5">{project.name}</h4>
                      <p class="text-xs text-black/40 mb-3 leading-relaxed">{project.description}</p>
                      <ul class="space-y-1.5">
                        {project.highlights.map((h) => (
                          <li class="text-xs text-black/50 flex items-baseline gap-2">
                            <span class="text-accent/40 flex-shrink-0">—</span>
                            {h}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="py-20 px-6 bg-white">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-xs tracking-[0.2em] text-black/30 uppercase mb-12">Skills & Experience</h2>
        <div class="space-y-10">
          {
            skillCategories.map((category) => (
              <div>
                <h3 class="text-xs font-medium text-black/40 tracking-wider mb-4 uppercase">
                  {category.name}
                </h3>
                <div class="flex flex-wrap gap-2">
                  {category.tags.map((tag) => (
                    <span class="text-xs px-3 py-1.5 rounded-full border border-accent/20 text-black/60 bg-accent/[0.03]">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
          <div>
            <h3 class="text-xs font-medium text-black/40 tracking-wider mb-4 uppercase">Industries</h3>
            <div class="flex flex-wrap gap-2">
              {
                industries.map((industry) => (
                  <span class="text-xs px-3 py-1.5 rounded-full border border-black/10 text-black/50">
                    {industry}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="py-20 px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-xs tracking-[0.2em] text-black/30 uppercase mb-8">Contact</h2>
        <p class="text-sm text-black/50 mb-10">お仕事のご相談やお問い合わせはお気軽にどうぞ。</p>

        <form
          action="https://formspree.io/f/YOUR_FORMSPREE_ID"
          method="POST"
          class="space-y-6 max-w-lg"
          id="contact-form-full"
        >
          <div>
            <label for="name-full" class="block text-xs text-black/40 tracking-wider mb-2">お名前</label>
            <input
              type="text"
              id="name-full"
              name="name"
              required
              class="w-full px-4 py-2.5 text-sm bg-[#fafafa] border border-black/10 rounded focus:outline-none focus:border-accent transition-colors"
            />
          </div>
          <div>
            <label for="email-full" class="block text-xs text-black/40 tracking-wider mb-2">メールアドレス</label>
            <input
              type="email"
              id="email-full"
              name="email"
              required
              class="w-full px-4 py-2.5 text-sm bg-[#fafafa] border border-black/10 rounded focus:outline-none focus:border-accent transition-colors"
            />
          </div>
          <div>
            <label for="message-full" class="block text-xs text-black/40 tracking-wider mb-2">メッセージ</label>
            <textarea
              id="message-full"
              name="message"
              rows="5"
              required
              class="w-full px-4 py-2.5 text-sm bg-[#fafafa] border border-black/10 rounded focus:outline-none focus:border-accent transition-colors resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="text-xs tracking-wider px-8 py-2.5 bg-accent text-white rounded hover:opacity-80 transition-opacity"
          >
            送信
          </button>
        </form>

        <div id="form-success-full" class="hidden max-w-lg p-6 rounded border border-accent/30 bg-accent/5">
          <p class="text-sm text-accent font-medium mb-1">送信しました</p>
          <p class="text-xs text-black/50">ありがとうございます。お返事まで少々お待ちください。</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById("contact-form-full") as HTMLFormElement;
  const success = document.getElementById("form-success-full");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: data,
        headers: { Accept: "application/json" },
      });
      if (res.ok) {
        form.classList.add("hidden");
        success?.classList.remove("hidden");
      }
    } catch {
      form.submit();
    }
  });
</script>
