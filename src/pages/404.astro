---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 | T.M.">
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center">
      <p class="text-xs font-mono text-accent/60 tracking-widest mb-6">404</p>
      <h1 class="text-xl font-semibold tracking-tight text-black/85 mb-4">
        ページが見つかりません
      </h1>
      <a
        href="/"
        class="text-xs tracking-wider text-black/30 hover:text-accent transition-colors"
      >
        &larr; Back to home
      </a>
    </div>
  </main>
</Layout>
