---
import { careerHistory } from "../data/career";
---

<section id="career" class="py-24 px-6">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center gap-3 mb-12">
      <span class="text-[10px] font-mono text-accent/60 tracking-widest">02</span>
      <div class="h-px flex-1 bg-black/10"></div>
      <span class="text-[10px] font-mono text-black/30 tracking-widest uppercase">Career</span>
    </div>

    <div class="space-y-16">
      {
        careerHistory.map((entry) => (
          <div class="group relative pl-6 border-l border-black/10 hover:border-accent/40 transition-colors">
            <div class="absolute left-0 top-[5px] -translate-x-1/2 w-2 h-2 rounded-full bg-accent group-hover:scale-125 transition-transform" />
            <p class="text-[10px] font-mono text-accent/70 tracking-widest mb-2">{entry.period}</p>
            <h3 class="text-base md:text-lg font-semibold text-black/80 mb-1">{entry.company}</h3>
            <p class="text-xs text-black/40 mb-6 font-mono tracking-wider">{entry.role}</p>
            <div class="space-y-4">
              {entry.projects.map((project) => (
                <div class="bg-white rounded-lg p-5 border border-black/5 hover:border-accent/20 transition-colors">
                  <h4 class="text-sm font-medium text-black/70 mb-1.5">{project.name}</h4>
                  <p class="text-xs text-black/40 mb-3 leading-relaxed">{project.description}</p>
                  <ul class="space-y-1.5">
                    {project.highlights.map((h) => (
                      <li class="text-xs text-black/50 flex items-baseline gap-2">
                        <span class="text-accent/40 flex-shrink-0">—</span>
                        {h}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
