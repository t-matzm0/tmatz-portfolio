---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section id="blog" class="py-24 px-6">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center gap-3 mb-12">
      <span class="text-[10px] font-mono text-accent/60 tracking-widest">04</span>
      <div class="h-px flex-1 bg-black/10"></div>
      <span class="text-[10px] font-mono text-black/30 tracking-widest uppercase">Blog</span>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-sm text-black/40">記事はまだありません。</p>
      ) : (
        <div class="space-y-8">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="block group">
              <p class="text-[10px] font-mono text-black/25 tracking-widest mb-2">
                {post.data.date.toLocaleDateString("ja-JP", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
              <h3 class="text-base font-medium text-black/70 group-hover:text-accent transition-colors mb-1">
                {post.data.title}
              </h3>
              <p class="text-xs text-black/40 leading-relaxed">{post.data.description}</p>
            </a>
          ))}
        </div>
      )
    }

    <div class="mt-10">
      <a
        href="/blog"
        class="group text-xs tracking-wider text-black/40 hover:text-accent transition-colors inline-flex items-center gap-2"
      >
        All posts
        <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>
  </div>
</section>
