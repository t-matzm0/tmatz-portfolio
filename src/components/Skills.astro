---
import { skillCategories, industries } from "../data/skills";
---

<section id="skills" class="py-24 px-6 bg-white">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center gap-3 mb-12">
      <span class="text-[10px] font-mono text-accent/60 tracking-widest">03</span>
      <div class="h-px flex-1 bg-black/10"></div>
      <span class="text-[10px] font-mono text-black/30 tracking-widest uppercase">Skills</span>
    </div>

    <div class="space-y-12">
      {
        skillCategories.map((category) => (
          <div>
            <h3 class="text-[10px] font-mono font-medium text-black/40 tracking-widest mb-5 uppercase">
              {category.name}
            </h3>
            <div class="flex flex-wrap gap-2">
              {category.tags.map((tag) => (
                <span class="text-xs px-3 py-1.5 rounded-full border border-accent/20 text-black/60 bg-accent/[0.03] hover:border-accent/50 hover:text-black/80 transition-colors cursor-default">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))
      }

      <div>
        <h3 class="text-[10px] font-mono font-medium text-black/40 tracking-widest mb-5 uppercase">
          Industries
        </h3>
        <div class="flex flex-wrap gap-2">
          {
            industries.map((industry) => (
              <span class="text-xs px-3 py-1.5 rounded-full border border-black/10 text-black/50 hover:border-black/30 hover:text-black/70 transition-colors cursor-default">
                {industry}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
